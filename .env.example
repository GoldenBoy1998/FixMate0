# API runtime
NODE_ENV=development
PORT=5000
BASE_PATH=/
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixmate

# Session security
SESSION_COOKIE_NAME=fixmate_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Bootstrap administrator (used only by a local seed/bootstrap command)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-in-development
